# Catalog Microservice Configuration
# Copy this file to .env and fill in the values

# Service Configuration
NODE_ENV=production
SERVICE_NAME=catalog-microservice
PORT=3200
DOMAIN=catalog.alfares.cz
FRONTEND_PORT=3204
FRONTEND_PORT_GREEN=3204

# Database Configuration (shared database-server)
DB_HOST=db-server-postgres
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=
DB_NAME=catalog_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis Configuration (shared database-server)
REDIS_HOST=db-server-redis
REDIS_PORT=6379

# External Shared Microservices
AUTH_SERVICE_URL=https://auth.alfares.cz
LOGGING_SERVICE_URL=https://logging.alfares.cz
NOTIFICATION_SERVICE_URL=https://notifications.alfares.cz
WAREHOUSE_SERVICE_URL=http://warehouse-microservice:3201
WAREHOUSE_AVAILABILITY_TIMEOUT_MS=5000
ORDERS_SERVICE_URL=http://orders-microservice:3203
ORDERS_STATISTICS_TIMEOUT_MS=5000

# JWT Configuration (must match auth-microservice)
JWT_SECRET=

# Logging
LOG_LEVEL=info
LOG_TIMESTAMP_FORMAT=YYYY-MM-DD HH:mm:ss

# CORS
CORS_ORIGIN=https://catalog.alfares.cz,https://allegro.alfares.cz,https://flipflop.alfares.cz

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_SERVICE_URL=
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=

JWT_TOKEN=
WAREHOUSE_SERVICE_TOKEN=
ORDERS_SERVICE_TOKEN=
CATALOG_INTERNAL_SERVICE_TOKEN=

# Smoke checks
CATALOG_SMOKE_AUTHORIZED=
CATALOG_SMOKE_AUTH_TOKEN=
CATALOG_SMOKE_INTERNAL_SERVICE_TOKEN=
CATALOG_SMOKE_ENABLE_BAZOS_AUTHORIZED=
CATALOG_SMOKE_BAZOS_PRODUCT_ID=
CATALOG_SMOKE_BAZOS_IDENTITY_ID=
CATALOG_SMOKE_BAZOS_CATEGORY=
CATALOG_SMOKE_BAZOS_LOCATION=
CATALOG_SMOKE_RETRIES=
CATALOG_SMOKE_RETRY_DELAY_MS=

# Contract monitoring
CATALOG_MONITOR_AUTHORIZED=
CATALOG_MONITOR_INCLUDE_BAZOS_AUTHORIZED=
CATALOG_MONITOR_TIMEOUT_MS=
